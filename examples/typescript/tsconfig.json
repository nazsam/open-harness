{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "openharness": [
        "../../typescript/src/index.ts"
      ]
    },
    "typeRoots": [
      "../../typescript/node_modules/@types"
    ]
  },
  "include": [
    "*.ts"
  ]
}